        "keyboards/keychron/c3_pro_8k": true,
        "keyboards/keychron/k0_max": true,
        "keyboards/keychron/k10_he": true,
        "keyboards/keychron/k10_max": true,
        "keyboards/keychron/k11_max": true,
        "keyboards/keychron/k13_max": true,
