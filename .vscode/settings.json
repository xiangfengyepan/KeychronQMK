        "keyboards/keychron/q1_max": true,
        "keyboards/keychron/q1v1": true,
        "keyboards/keychron/q1v2": true,
        "keyboards/keychron/q2": true,
        "keyboards/keychron/q2_he": true,
        "keyboards/keychron/q2_max": true,
        "keyboards/keychron/q3": true,
        "keyboards/keychron/q3_he": true,
        "keyboards/keychron/q3_max": true,
        "keyboards/keychron/q4": true,
