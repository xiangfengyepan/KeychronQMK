        "keyboards/keychron/k2_he": true,
        "keyboards/keychron/k2_max": true,
        "keyboards/keychron/k2_version_3": true,
        "keyboards/keychron/k3_max": true,
        "keyboards/keychron/k3_version_3": true,
        "keyboards/keychron/k4_he": true,
        "keyboards/keychron/k4_max": true,
        "keyboards/keychron/k4_version_3": true,
        "keyboards/keychron/k5_max": true,
        "keyboards/keychron/k6_he": true,
        "keyboards/keychron/k7_max": true,
        "keyboards/keychron/k8_he": true,
        "keyboards/keychron/k8_max": true,
        "keyboards/keychron/k8_pro": true,
        "keyboards/keychron/k9_max": true,
        "keyboards/keychron/q0": true,
